# v2's switches file. Copy to `.env` beside this file; on the box that is ~/snipe-v2/.env.
#
# THESE KEYS LIVE HERE AND NOWHERE ELSE. `io/dotenv.ts` reads them from this file only:
# not from the process environment, not from `v1/.env`, and not from `run-live.sh`.
# A missing file, a missing MODE, or MODE=observe refuses to boot. There is no silent
# watch-only fallback.
#
# live sends. shadow signs and never sends. RESTART-ONLY.
MODE=shadow

# Dashboard Economy/Paid selection. Missing means paid. Dashboard changes need no restart.
# Economy uses public APIs for monitoring and new buys, with uncapped paid exit rescue.
API_MODE=paid

# default stake for books without a dashboard override. HOT.
TRADE_SIZE_ETH=0.001

# Public log polling while every book is halted and the wallet is flat. Restart-only.
# Recovery checks paid coverage before allowing an entry. Does not clear any halt.
RPC_HALTED_ECONOMY=0
# Enable each optimization only after its acceptance comparison passes.
RPC_TX_CACHE=0
RPC_FILTER_MODE=off
RPC_QUIET_ECONOMY=0
RPC_HALTED_READ_ECONOMY=0

# exact wei instead, if you prefer. Wins over TRADE_SIZE_ETH when both are set. HOT.
# SIZE_WEI=1000000000000000
#
# HALT is gone. Use STOP ALL on the dashboard to stop new buys. Open bags still sell.
# A leftover HALT= line in this file is ignored.

# Everything else -- the key, the RPC and websocket endpoints, the chain id -- is the machine's
# description and is read from ENV_FILE (default ../v1/.env). Never put a key in this file.
